# DOMAIN unset: plain HTTP on :80. DOMAIN=airspace.example.com: automatic HTTPS
# on 80 and 443 with a Let's Encrypt certificate.
{$DOMAIN::80} {
	encode zstd gzip

	# The API, including server-sent events: flush every write at once. /auth/* is GitHub sign-in.
	@api path /api/* /auth/*
	handle @api {
		reverse_proxy api:8787 {
			flush_interval -1
		}
	}

	# Sign-in with GitHub and sign-out.
	handle /auth/* {
		reverse_proxy api:8787
	}

	# The single-page app: unknown paths such as /tower fall back to index.html.
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@unhashed not path /assets/*
		header @unhashed Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
