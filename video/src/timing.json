  "tower": {
   "start": 45.345,
   "end": 78.405,
   "chunks": [
    {
     "text": "This is Tower, the session view, replaying two real Claude Code sessions.",
     "start": 45.345,
     "end": 49.86
    },
    {
     "text": "Everything here is read live from the graph.",
     "start": 50.14,
     "end": 52.405
    },
    {
     "text": "agent-a makes slugify's option keyword-only. Its airspace covers slugify and everything that calls it.",
     "start": 52.61,
     "end": 58.788
    },
    {
     "text": "agent-b, on its own branch, writes a call with the old keyword.",
     "start": 59.068,
     "end": 62.817
    },
    {
     "text": "The airspaces overlap, so the edit is held before it is written.",
     "start": 63.097,
     "end": 66.59
    },
    {
     "text": "The hold names who is changing slugify, the new signature, and the path from agent-b's code to it.",
     "start": 66.87,
     "end": 72.77
    },
    {
     "text": "agent-b retries with the new keyword. The call fits, so it is cleared, and both agents land.",
     "start": 73.05,
     "end": 78.405
    }
   ],
