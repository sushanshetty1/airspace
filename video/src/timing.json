    {
     "text": "Split a feature between two coding agents, and each one passes its own tests.",
     "start": 0.7,
     "end": 5.425
    },
    {
     "text": "Merge their branches, and the build is red.",
     "start": 5.705,
     "end": 7.775
    },
    {
     "text": "One agent changed a function. The other, on its own branch, was still calling the old version.",
     "start": 8.055,
     "end": 13.17
    },
    {
     "text": "With worktrees alone, we measured 0 of 18 merges green.",
     "start": 13.45,
     "end": 17.39
    }
